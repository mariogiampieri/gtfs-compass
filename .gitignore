# Secrets — never commit real environment files
.env
.env.*
!.env.example

# Cloudflare / wrangler local state
.wrangler/
api/node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
ingest/dist/

# Font source cache (genfonts.sh downloads TTFs here; generated .c is committed)
firmware/tools/.fontcache/

# Editor / local tooling
.obsidian/
.DS_Store
.claude/
node_modules/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
