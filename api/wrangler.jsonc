{
  "name": "gtfs-compass-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  "vars": {
    // Feeds reachable through the public routes. The D1 feeds table also
    // holds ~2,800 crowd-sourced catalog rows whose URLs must never be
    // fetched on an anonymous caller's say-so — reachability is by this
    // explicit allowlist. A second agency is a config change, not code.
    "CURATED_FEEDS": ["mta-subway", "mta-bus", "citibike"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gtfs-compass",
      "database_id": "eb62cad4-cb64-4809-93c2-d1e3863737ce"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FEED_DO",
        "class_name": "FeedDO"
      },
      {
        "name": "GBFS_DO",
        "class_name": "GbfsDO"
      },
      {
        "name": "ALERT_DO",
        "class_name": "AlertDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FeedDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["GbfsDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AlertDO"]
    }
  ]
}
