# gtfs-compass ingest configuration.
# Copy to .env (gitignored) and fill in the required values. The ingest job
# reads these from its process environment — e.g. `set -a; source .env; set +a`
# or an equivalent in your cron wrapper.

# --- Required: Cloudflare D1 access -----------------------------------------

# Your Cloudflare account id (Cloudflare dashboard -> Workers & Pages ->
# right-hand sidebar, or `npx wrangler whoami`).
CLOUDFLARE_ACCOUNT_ID=

# The D1 database id printed by `npx wrangler d1 create gtfs-compass`
# (also in api/wrangler.jsonc once configured).
CLOUDFLARE_D1_DATABASE_ID=

# An API token with the "Account -> D1 -> Edit" permission ONLY.
# Create at https://dash.cloudflare.com/profile/api-tokens -> Create Token
# -> Custom token. Scope it to this one account; no other permissions needed.
CLOUDFLARE_API_TOKEN=

# --- Optional ---------------------------------------------------------------

# Override the Mobility Database catalog CSV location.
# Default: https://files.mobilitydatabase.org/feeds_v2.csv
#MOBILITY_DB_CSV_URL=

# Comma-separated feed ids to static-ingest with `static` / `all`.
# Default: the curated seed list (currently "mta-subway,citibike").
#INGEST_STATIC_FEEDS=mta-subway,citibike

# Seconds between D1 API requests (stays under Cloudflare's global
# 1,200 requests / 5 minutes per-token limit). Default: 0.25
#D1_PACE_SECONDS=0.25

# Path of the local (same-host) run-lock file. Default: /tmp/gtfs-compass-ingest.lock
#INGEST_LOCK_FILE=/tmp/gtfs-compass-ingest.lock

# --- Worker / realtime layer (api/) -----------------------------------------
# The Worker reads feed config from D1 via its binding, and MTA subway
# realtime feeds require no API key. Deploy auth is handled by `wrangler
# login`. Worker vars below are set in api/wrangler.jsonc `vars` (or
# `wrangler secret put` where noted), not read from this file — listed here
# so self-hosters know they exist.
#
# The curated-feed allowlist is `vars.CURATED_FEEDS` in api/wrangler.jsonc
# (JSON array of feed ids). Only listed feeds are reachable through the
# public routes; adding an agency is a config change there plus a seed in
# ingest/src/gtfs_compass_ingest/seeds.py.

# Optional. Locate accuracy gate in meters: a resolved position coarser than
# this is returned as {"known": false}, never passed through. Default: 500
#LOCATE_MAX_ACCURACY_M=500

# Optional. Abort timeout in milliseconds for each locate provider fetch
# (BeaconDB has no SLA; a hung call must not eat the device's latency
# budget). Default: 2000
#LOCATE_TIMEOUT_MS=2000

# Optional. Shared secret gating the locate diagnostics surfaces
# (POST /v1/locate with log:true, POST /v1/locate/ref, GET /v1/locate/log).
# Set as a Worker secret — `cd api && npx wrangler secret put DIAG_TOKEN` —
# and send it as an `Authorization: Bearer <token>` header. Unset means the
# diagnostics surfaces are disabled. Never commit a real value.
#DIAG_TOKEN=

# Optional, NOT YET WIRED. Unwired Labs LocationAPI key for the locate
# chain's paid fallback slot (spec step 2). The provider slot is documented
# in api/src/locate.ts but deliberately unbuilt per the build order.
#UNWIREDLABS_KEY=
